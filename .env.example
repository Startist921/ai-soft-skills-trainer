# Backend port
PORT=8080

# Сколько тренировок доступно пользователю в день
DAILY_TRAINING_LIMIT=5

# Адрес inference-сервиса ml-service в Docker Compose или локально
ML_SERVICE_URL=http://ml-service:8087

# Название модели, которая используется ml-service
MODEL_NAME=GigaChat

# Токен/ключ доступа к сервису Gigachat/Sber, если требуется.
# Оставьте пустым, если у вас локальная конфигурация без аутентификации.
SBER_AUTH=

# Адрес PostgreSQL для хранения пользователей, сессий и фидбэков.
# В Docker Compose значение задаётся автоматически. Для локального запуска используйте что-то вроде:
# DATABASE_URL=postgres://softskills:softskills@localhost:5432/softskills?sslmode=disable
DATABASE_URL=postgres://softskills:softskills@postgres:5432/softskills?sslmode=disable

# Генеративные параметры
MAX_NEW_TOKENS=300
TEMPERATURE=0.55
TOP_P=0.85
